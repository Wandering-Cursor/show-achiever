"use client";

import sendQRCodeDataToBackend from '@/api/sendQrCodeData';
import { init, qrScanner, miniApp, initData, popup } from '@telegram-apps/sdk-react';


import { useEffect } from 'react';


function checkUUIDv4(data: string) {
    return data.match(/^[0-9A-F]{8}-[0-9A-F]{4}-4[0-9A-F]{3}-[89AB][0-9A-F]{3}-[0-9A-F]{12}$/i);
}


export default function TelegramMiniApp() {
    useEffect(
        () => {
            init();

            if (qrScanner.open.isAvailable()) {
                qrScanner.open({
                    text: 'Scan the QR',
                    onCaptured(qr: string) {
                        if (!checkUUIDv4(qr)) {
                            popup.open(
                                {
                                    message: 'Invalid QR code. Try again.',
                                }
                            );

                            return;
                        }

                        alert(
                            JSON.stringify({
                                user: initData.user(),
                                chat: initData.chat(),
                                chatInstance: initData.chatInstance(),
                                chatType: initData.chatType(),
                                hash: initData.hash(),
                                queryId: initData.queryId(),
                                receiver: initData.receiver(),
                                startParam: initData.startParam(),
                                raw: initData.raw(),
                            }
                            )
                        )

                        sendQRCodeDataToBackend(
                            {
                                payload: qr,
                                chat_id: initData.user()?.id || -1
                            }
                        )

                        qrScanner.close();
                        miniApp.close();
                    },
                });
            }
        },
        []
    );

    return (
        <div>
            <h1>Please close the Mini-App if it was not closed automatically</h1>
        </div>
    );
}